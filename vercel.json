{
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{src/**,bootstrap.php,config.php,data/parcely.sqlite}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.php" },
    { "source": "/tiles/(.*)", "destination": "/api/index.php" }
  ]
}
